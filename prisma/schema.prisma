generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  kontak    String
  paket     String
  deploy    Boolean  @default(false)
  deskripsi String   @db.Text
  estimasi  Int
  status    String   @default("BARU")
  deadline  String?
  createdAt DateTime @default(now())
}

model Project {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String   @db.Text
  tech      String
  url       String?
  gambar    String?  @db.Text
  createdAt DateTime @default(now())
}

model CalendarNote {
  id        Int      @id @default(autoincrement())
  tanggal   String
  judul     String
  catatan   String?  @db.Text
  createdAt DateTime @default(now())
}